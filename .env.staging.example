# Thoon staging profile
# Copy this into your staging secret store. Do not commit real values.

THOON_APP_MODE=paper
THOON_DATABASE_PROVIDER=postgres
THOON_SAAS_MODE=disabled
DATABASE_URL=postgres://user:password@host:5432/thoon_staging
THOON_DATA_FILE=.thoon-data/thoon-staging-db.json
THOON_MARKET_DATA_PROVIDER=binance
THOON_PRODUCTION_BASE_URL=https://staging.example.com
THOON_RELEASE=staging
THOON_LOG_LEVEL=info
THOON_AGENT_AI_INCLUDE_SOURCE=false
THOON_TRADINGVIEW_MCP_NAME=tradingview
THOON_TRADINGVIEW_MCP_COMMAND=npx
THOON_TRADINGVIEW_MCP_ARGS=-y tradingview-mcp-server@0.6.1

THOON_AUTH_MODE=local-required
THOON_AUTH_SESSION_DAYS=1
THOON_AUTH_SESSION_SECRET=replace-with-a-long-random-staging-session-secret
THOON_ADMIN_EMAIL=owner@thoon.local
THOON_ADMIN_PASSWORD_HASH=replace-with-output-from-npm-run-auth-hash

THOON_RATE_LIMIT_ENABLED=true
THOON_LOGIN_RATE_LIMIT_MAX=5
THOON_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
THOON_MUTATION_RATE_LIMIT_MAX=240
THOON_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
THOON_EDGE_RATE_LIMIT_POLICY=configured
THOON_TRUST_PROXY_HEADERS=true

THOON_AUDIT_MAX_EVENTS=5000
THOON_AUDIT_RETENTION_DAYS=365
THOON_CRON_SECRET=replace-with-a-long-random-staging-cron-secret
THOON_BETA_INVITE_DAYS=14

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PRICE_PRO_MONTHLY=price_replace_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_replace_pro_yearly
STRIPE_PRICE_ELITE_MONTHLY=price_replace_elite_monthly
STRIPE_PRICE_ELITE_YEARLY=price_replace_elite_yearly

BINANCE_MARKET_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_MARKET_BASE_URL=https://fapi.binance.com
BINANCE_TRADE_BASE_URL=https://api.binance.com
BYBIT_MARKET_BASE_URL=https://api.bybit.com
OKX_MARKET_BASE_URL=https://www.okx.com
BITGET_MARKET_BASE_URL=https://api.bitget.com
KRAKEN_MARKET_BASE_URL=https://api.kraken.com
KUCOIN_MARKET_BASE_URL=https://api.kucoin.com
COINBASE_ADVANCED_MARKET_BASE_URL=https://api.exchange.coinbase.com

THOON_LIVE_OPERATOR_MODE=single-user
THOON_LIVE_EXCHANGE_PROVIDER=disabled
THOON_LIVE_ORDER_ENDPOINT=test
EXECUTION_LIVE_TRADING_ENABLED=false
EXECUTION_HTTP_TIMEOUT_SECONDS=10
EXECUTION_RETRY_ATTEMPTS=3
EXECUTION_BACKOFF_BASE_SECONDS=0.25
EXECUTION_API_ERROR_SPIKE_THRESHOLD=5
EXECUTION_API_ERROR_WINDOW_SECONDS=60
EXECUTION_LATENCY_THRESHOLD_MS=2500
THOON_ENCRYPTION_KEY=replace-with-a-long-random-staging-encryption-key

# Set only in the staging secret store, never in git.
# For single-user live CEX routing use THOON_APP_MODE=live-enabled,
# THOON_LIVE_EXCHANGE_PROVIDER=bud and EXECUTION_LIVE_TRADING_ENABLED=true
# after paper evidence and readiness gates pass.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# DEX perps remain read/readiness only until official isolated signers exist.
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_MAIN_WALLET_ADDRESS=
HYPERLIQUID_API_WALLET_PRIVATE_KEY=
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_OFFICIAL_SIGNER_ENABLED=false
DYDX_INDEXER_BASE_URL=https://indexer.dydx.trade
DYDX_OWNER_ADDRESS=
DYDX_PERMISSIONED_PRIVATE_KEY=
DYDX_AUTHENTICATOR_ID=
DYDX_SUBACCOUNT_NUMBER=0
DYDX_OFFICIAL_SIGNER_ENABLED=false
