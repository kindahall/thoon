# Thoon runtime
# paper keeps every execution local. live-enabled must only be used after wiring a real exchange executor.
THOON_APP_MODE=paper
THOON_DATABASE_PROVIDER=json
THOON_SAAS_MODE=disabled
DATABASE_URL=postgresql://bud_ai:bud_ai_local_only_change_me@127.0.0.1:55434/bud_ai
THOON_DATA_FILE=.thoon-data/thoon-db.json
THOON_MARKET_DATA_PROVIDER=bud
THOON_MARKET_REFRESH_SECONDS=30
THOON_MARKET_KLINE_LIMIT=120
THOON_BUD_BACKEND_URL=http://127.0.0.1:8000
THOON_BUD_BACKEND_TIMEOUT_MS=20000
# Optional override for /api/bud/process start/stop. Default: backend/.venv/bin/uvicorn.
THOON_BUD_UVICORN_BIN=
THOON_PRODUCTION_BASE_URL=
THOON_RELEASE=local
THOON_LOG_LEVEL=info
THOON_RATE_LIMIT_ENABLED=true
THOON_LOGIN_RATE_LIMIT_MAX=5
THOON_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
THOON_MUTATION_RATE_LIMIT_MAX=240
THOON_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
THOON_EDGE_RATE_LIMIT_POLICY=missing
THOON_TRUST_PROXY_HEADERS=false
THOON_AUDIT_MAX_EVENTS=1000
THOON_AUDIT_RETENTION_DAYS=180
THOON_CRON_SECRET=
THOON_BETA_INVITE_DAYS=14

# Stripe Billing. Required when THOON_SAAS_MODE=enabled and paid plans are active.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_YEARLY=

# Strategy Agent research provider.
# codex = direct Codex OAuth transport using your logged-in ChatGPT/Codex plan; no OpenAI API key required.
# openai/openai-compatible = server-side direct API provider if you explicitly want API billing.
# local = deterministic local guardrails without model calls.
THOON_AGENT_AI_PROVIDER=codex
THOON_AGENT_AI_MODEL=gpt-5.5
THOON_AGENT_CHAT_MODEL=gpt-5.5
# Optional override. Default: $CODEX_HOME/auth.json or ~/.codex/auth.json.
THOON_AGENT_CODEX_AUTH_FILE=
THOON_AGENT_AI_ENDPOINT=responses
THOON_AGENT_AI_BASE_URL=https://api.openai.com/v1
THOON_AGENT_AI_INCLUDE_SOURCE=false
THOON_AGENT_AI_API_KEY=
THOON_AGENT_AI_TIMEOUT_MS=90000
THOON_TRADINGVIEW_MCP_NAME=tradingview
THOON_TRADINGVIEW_MCP_COMMAND=npx
THOON_TRADINGVIEW_MCP_ARGS=-y tradingview-mcp-server@0.6.1

# Production auth. Generate THOON_ADMIN_PASSWORD_HASH with:
# npm run auth:hash -- "your-long-password"
THOON_AUTH_MODE=local-required
# Keep true/omitted in production. Use false only for local HTTP testing.
THOON_COOKIE_SECURE=true
THOON_AUTH_SESSION_DAYS=7
THOON_AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
THOON_ADMIN_EMAIL=owner@thoon.local
THOON_ADMIN_PASSWORD_HASH=

BINANCE_MARKET_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_MARKET_BASE_URL=https://fapi.binance.com
BINANCE_TRADE_BASE_URL=https://api.binance.com
BYBIT_MARKET_BASE_URL=https://api.bybit.com
OKX_MARKET_BASE_URL=https://www.okx.com
BITGET_MARKET_BASE_URL=https://api.bitget.com
KRAKEN_MARKET_BASE_URL=https://api.kraken.com
KUCOIN_MARKET_BASE_URL=https://api.kucoin.com
COINBASE_ADVANCED_MARKET_BASE_URL=https://api.exchange.coinbase.com

# Live execution remains locked unless these values are intentionally changed.
# For this single-user app, route real signed execution through Bud.
THOON_LIVE_OPERATOR_MODE=single-user
THOON_LIVE_EXCHANGE_PROVIDER=disabled
THOON_LIVE_ORDER_ENDPOINT=test
EXECUTION_LIVE_TRADING_ENABLED=false
EXECUTION_HTTP_TIMEOUT_SECONDS=10
EXECUTION_RETRY_ATTEMPTS=3
EXECUTION_BACKOFF_BASE_SECONDS=0.25
EXECUTION_API_ERROR_SPIKE_THRESHOLD=5
EXECUTION_API_ERROR_WINDOW_SECONDS=60
EXECUTION_LATENCY_THRESHOLD_MS=2500

# Required before storing real exchange API secrets.
# Use a long random value in production, never commit it.
THOON_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional raw env credentials for Bud signed execution.
# Set THOON_APP_MODE=live-enabled, THOON_DATABASE_PROVIDER=postgres,
# THOON_LIVE_EXCHANGE_PROVIDER=bud and EXECUTION_LIVE_TRADING_ENABLED=true
# only after paper evidence and readiness checks pass.
# Keep withdrawals disabled on exchange side.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# DEX perps: readable when addresses are configured. Live signing is implemented
# through the official SDKs and remains blocked until explicitly enabled here,
# dependencies are installed, and Bud live-readiness verifies the wallet/authenticator.
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_MAIN_WALLET_ADDRESS=
HYPERLIQUID_API_WALLET_PRIVATE_KEY=
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_OFFICIAL_SIGNER_ENABLED=false
HYPERLIQUID_MARKET_ORDER_SLIPPAGE=0.005
DYDX_NETWORK=mainnet
DYDX_INDEXER_BASE_URL=https://indexer.dydx.trade
DYDX_WEBSOCKET_INDEXER_URL=wss://indexer.dydx.trade/v4/ws
DYDX_NODE_URL=oegs.dydx.trade:443
DYDX_OWNER_ADDRESS=
DYDX_PERMISSIONED_PRIVATE_KEY=
DYDX_AUTHENTICATOR_ID=
DYDX_SUBACCOUNT_NUMBER=0
DYDX_OFFICIAL_SIGNER_ENABLED=false
DYDX_MARKET_ORDER_SLIPPAGE=0.005
DYDX_SHORT_TERM_GOOD_TIL_BLOCKS=20
DYDX_LIMIT_ORDER_FLAGS=SHORT_TERM
DYDX_LONG_TERM_GOOD_TIL_SECONDS=86400

# Additional read/test integrations.
OKX_API_KEY=
OKX_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
COINBASE_ADVANCED_API_KEY=
COINBASE_ADVANCED_API_SECRET=
