# Thoon runtime
# paper keeps every execution local. live-enabled must only be used after wiring a real exchange executor.
THOON_APP_MODE=paper
THOON_DATABASE_PROVIDER=json
DATABASE_URL=
THOON_DATA_FILE=.thoon-data/thoon-db.json
THOON_MARKET_DATA_PROVIDER=binance
THOON_MARKET_REFRESH_SECONDS=30
THOON_MARKET_KLINE_LIMIT=120
THOON_PRODUCTION_BASE_URL=
THOON_RELEASE=local
THOON_LOG_LEVEL=info
THOON_RATE_LIMIT_ENABLED=true
THOON_LOGIN_RATE_LIMIT_MAX=5
THOON_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
THOON_MUTATION_RATE_LIMIT_MAX=240
THOON_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
THOON_EDGE_RATE_LIMIT_POLICY=missing
THOON_AUDIT_MAX_EVENTS=1000
THOON_AUDIT_RETENTION_DAYS=180
THOON_CRON_SECRET=

# Strategy Agent research provider.
# codex = server-side Thoonix mode using the local Codex CLI for research/backtesting/paper tests.
# openai/openai-compatible = remote provider, server-side only.
THOON_AGENT_AI_PROVIDER=codex
THOON_AGENT_AI_MODEL=gpt-5.5
THOON_AGENT_CODEX_BINARY=/Applications/Codex.app/Contents/Resources/codex
THOON_AGENT_CODEX_SANDBOX=danger-full-access
THOON_AGENT_AI_ENDPOINT=responses
THOON_AGENT_AI_BASE_URL=https://api.openai.com/v1
THOON_AGENT_AI_INCLUDE_SOURCE=false
THOON_AGENT_AI_API_KEY=
THOON_AGENT_AI_TIMEOUT_MS=90000
THOON_TRADINGVIEW_MCP_NAME=tradingview
THOON_TRADINGVIEW_MCP_COMMAND=npx
THOON_TRADINGVIEW_MCP_ARGS=-y tradingview-mcp-server@0.6.1

# Production auth. Generate THOON_ADMIN_PASSWORD_HASH with:
# npm run auth:hash -- "your-long-password"
THOON_AUTH_MODE=local-required
THOON_AUTH_SESSION_DAYS=7
THOON_AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
THOON_ADMIN_EMAIL=owner@thoon.local
THOON_ADMIN_PASSWORD_HASH=

BINANCE_MARKET_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_MARKET_BASE_URL=https://fapi.binance.com
BINANCE_TRADE_BASE_URL=https://api.binance.com
BYBIT_MARKET_BASE_URL=https://api.bybit.com
OKX_MARKET_BASE_URL=https://www.okx.com
BITGET_MARKET_BASE_URL=https://api.bitget.com
KRAKEN_MARKET_BASE_URL=https://api.kraken.com
KUCOIN_MARKET_BASE_URL=https://api.kucoin.com
COINBASE_ADVANCED_MARKET_BASE_URL=https://api.exchange.coinbase.com

# Live execution remains locked unless both values are intentionally changed.
# Saved trade keys must also be tested until their API key status is active.
THOON_LIVE_EXCHANGE_PROVIDER=disabled
THOON_LIVE_ORDER_ENDPOINT=test

# Required before storing real exchange API secrets.
# Use a long random value in production, never commit it.
THOON_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional raw env credentials for external tooling. Thoon stores API keys through /preferences/exchange-api.
# Keep withdrawals disabled on exchange side.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
COINBASE_ADVANCED_API_KEY=
COINBASE_ADVANCED_API_SECRET=
