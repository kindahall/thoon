{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Thoon",
  "version": "0.1.0",
  "identifier": "app.thoon.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:3001",
    "devUrl": "http://127.0.0.1:3001",
    "beforeDevCommand": "npm run desktop:server",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thoon",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
